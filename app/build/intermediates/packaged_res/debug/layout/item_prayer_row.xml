<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:layoutDirection="ltr"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/txtName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textDirection="rtl"
        android:textAlignment="viewEnd"
        android:text="الفجر"
        android:textColor="@color/black"
        android:textSize="28sp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeMaxTextSize="32sp"
        app:autoSizeStepGranularity="1sp"
        android:includeFontPadding="false"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtAdhan"
        app:layout_constraintHorizontal_weight="1.15" />

    <TextView
        android:id="@+id/txtAdhan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:gravity="center"
        android:text="06:30"
        android:textColor="@color/black"
        android:textSize="28sp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeMaxTextSize="32sp"
        app:autoSizeStepGranularity="1sp"
        android:includeFontPadding="false"
        app:layout_constraintEnd_toStartOf="@id/txtName"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtIqama"
        app:layout_constraintHorizontal_weight="1" />

    <TextView
        android:id="@+id/txtIqama"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:textDirection="ltr"
        android:textAlignment="viewStart"
        android:text="06:35"
        android:textColor="@color/black"
        android:textSize="28sp"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="16sp"
        app:autoSizeMaxTextSize="32sp"
        app:autoSizeStepGranularity="1sp"
        android:includeFontPadding="false"
        android:layout_marginStart="13dp"
        app:layout_constraintEnd_toStartOf="@id/txtAdhan"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_weight="1" />

</androidx.constraintlayout.widget.ConstraintLayout>
