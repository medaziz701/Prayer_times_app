<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:keepScreenOn="true"
    android:background="@android:color/white">

    <!-- Image de fond (panneau principal). Largeur/hauteur 0dp + contraintes = remplit l'espace entre les marges.
         Pour changer l'épaisseur de la bordure blanche autour, modifiez les marges 24dp (Start/End/Top/Bottom).
         L'image s'arrondit via Rounded60 et se cale par centerCrop. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/arriereplan"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:shapeAppearanceOverlay="@style/Rounded60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cadre des tirets lumineux (tour complet = 1 minute).
         Largeur/hauteur 0dp + contraintes = recouvre toute la zone.
         Pour l'épaisseur de la bordure lumineuse: ajustez les marges du panneau au-dessus (imgBackground)
         ou modifiez le code de AnimatedTicksView (tickLen/strokeWidth) si vous voulez des tirets plus longs/épais. -->
    <com.mosque.prayer.ui.AnimatedTicksView
        android:id="@+id/animatedTicks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenu principal (tout à l'intérieur du panneau).
         Largeur/hauteur 0dp + contraintes = remplit le panneau, avec marges identiques à l'image de fond. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Boîte de l'heure (horloge).
             Modifiez layout_width/layout_height (168dp x 114dp) pour la taille du bloc.
             La taille du texte de l'heure se règle avec android:textSize de @id/txtTime. -->
        <FrameLayout
            android:id="@+id/timeBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/txtRiy"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:includeFontPadding="false"

                android:textColor="@color/white"
                android:textSize="12sp" />

            <!-- Texte de l'heure. Pour agrandir/réduire l'horloge, ajustez textSize (54sp) ou la taille du parent timeBox. -->
            <TextView
                android:id="@+id/txtTime"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="09:41"
                android:textColor="@color/white"
                android:textSize="64sp"
                app:autoSizeMaxTextSize="120sp"
                app:autoSizeMinTextSize="24sp"
                app:autoSizeStepGranularity="2sp"
                app:autoSizeTextType="uniform" />

        </FrameLayout>

        <!-- Carte date (grégorien/hégirien + jour).
             Hauteur fixe 78dp; largeur 0dp + contraintes => pleine largeur entre marges.
             Modifiez les marges Start/End (32dp) et Top selon besoin. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardDate"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_card_date_pill"
            android:layoutDirection="ltr"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintTop_toBottomOf="@id/timeBox">

        <!-- Colonne gauche (date grégorienne). Pour la largeur relative, ajustez app:layout_constraintWidth_percent (0.32). -->
            <!-- Colonne gauche : Date grégorienne -->
            <!-- Colonne gauche : Date grégorienne -->
            <LinearLayout
                android:id="@+id/leftGregorian"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="19dp"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/dayName"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintWidth_percent="0.32">

                <!-- 26 ديسمبر ( 12 ) -->
                <TextView
                    android:id="@+id/txtGregorianSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="26 ديسمبر ( 12 )"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <!-- 2025 -->
                <TextView
                    android:id="@+id/txtGregorianYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="2025"
                    android:textColor="@color/black"
                    android:textSize="26sp" />
            </LinearLayout>


            <!-- Nom du jour : الخميس -->
            <TextView
                android:id="@+id/dayName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="الخميس"
                android:textColor="@color/black"
                android:textSize="32sp"
                android:maxLines="1"
                android:ellipsize="end"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="16sp"
                app:autoSizeMaxTextSize="32sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintStart_toEndOf="@id/leftGregorian"
                app:layout_constraintEnd_toStartOf="@id/rightHijri"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


            <!-- Colonne droite : Date hégirienne -->
            <LinearLayout
                android:id="@+id/rightHijri"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="end|center_vertical"
                android:paddingEnd="19dp"
                android:orientation="vertical"
                app:layout_constraintStart_toEndOf="@id/dayName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintWidth_percent="0.32">

                <!-- 5 رجب ( 7 ) -->
                <TextView
                    android:id="@+id/txtHijriSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="5 رجب ( 7 )"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <!-- 1447 -->
                <TextView
                    android:id="@+id/txtHijriYear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="1447"
                    android:textColor="@color/black"
                    android:textSize="26sp" />
            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Flèches de navigation par jour. Changez layout_width/height (36x56dp) et textSize (20sp) pour leur taille. -->
        <TextView
            android:id="@+id/btnPrevDay"
            android:layout_width="36dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="❮"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:contentDescription="Previous day"
            app:layout_constraintTop_toTopOf="@id/cardTable"
            app:layout_constraintBottom_toBottomOf="@id/cardTable"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/btnNextDay"
            android:layout_width="36dp"
            android:layout_height="56dp"
            android:gravity="center"
            android:text="❯"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true"
            android:elevation="16dp"
            android:contentDescription="Next day"
            app:layout_constraintTop_toTopOf="@id/cardTable"
            app:layout_constraintBottom_toBottomOf="@id/cardTable"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            android:layout_marginEnd="4dp" />

        <!-- Tableau des prières.
             Changez layout_width/layout_height (302x372dp) pour la taille du bloc.
             Pour occuper toute la largeur disponible, mettez layout_width="0dp" et gardez les contraintes Start/End. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="30dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_card_r51"
            android:layoutDirection="ltr"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardDate">

            <TextView
                android:id="@+id/hPrayer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="17dp"
                android:gravity="end"
                android:text="@string/prayer"
                android:textAlignment="viewEnd"
                android:textColor="@color/black"
                android:textDirection="rtl"
                android:textSize="18sp"
                android:includeFontPadding="false"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1.15"
                app:layout_constraintStart_toEndOf="@id/hAdhan"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/hAdhan"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="0dp"
                android:gravity="center"
                android:text="@string/adhan"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textDirection="rtl"
                android:textSize="18sp"
                android:includeFontPadding="false"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintEnd_toStartOf="@id/hPrayer"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@id/hIqama"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/hIqama"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="34dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="0dp"
                android:gravity="start"
                android:text="@string/iqama"
                android:textAlignment="viewStart"
                android:textColor="@color/black"
                android:textDirection="rtl"
                android:textSize="18sp"
                android:includeFontPadding="false"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="12sp"
                app:autoSizeMaxTextSize="18sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintEnd_toStartOf="@id/hAdhan"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/bHeaderBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="hPrayer,hAdhan,hIqama" />

            <!-- Conteneur des lignes (RecyclerView). Sa hauteur suit le contenu; la taille globale vient de cardTable. -->
            <LinearLayout
                android:id="@+id/tableRows"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="0dp"
                android:paddingTop="12dp"
                android:paddingEnd="0dp"
                android:paddingBottom="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/bHeaderBottom">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvPrayers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never"
                    android:scrollbars="none" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Compteurs (Iqama + Prochaine prière).
         Largeur 0dp + contraintes pour centrer. Marges Start/End/Top/Bottom pour espacement.
         Les deux colonnes utilisent layout_weight=1 chacune. -->
    <LinearLayout
        android:id="@+id/rowCounters"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="0dp"
        android:layout_marginTop="10dp"
        android:layoutDirection="rtl"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/cardTable"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/iqamaContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="10dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/labelIqamaAfter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iqama_after"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <!-- Compteur Iqama: hauteur du pilulier via layout_height (50dp), taille texte via textSize (22sp). -->
            <TextView
                android:id="@+id/txtIqamaCountdown"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_capsule"
                android:gravity="center"
                android:text="10"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/nextContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next_prayer"
                android:textColor="@color/white"
                android:textSize="16sp" />

            <!-- Compteur prochaine prière: hauteur du pilulier via layout_height (50dp), texte via textSize (22sp). -->
            <TextView
                android:id="@+id/txtNextCountdown"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_pill_capsule"
                android:gravity="center"
                android:text="01:20:41"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

    <!-- Titre du hadith. Centré verticalement entre les compteurs et la carte. -->
    <TextView
        android:id="@+id/txtHadithTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="0dp"
        android:text="@string/hadith_title"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/rowCounters"
        app:layout_constraintBottom_toTopOf="@id/cardHadith"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <!-- Carte du hadith. Directement sous les compteurs; le titre flotte au milieu entre les deux. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardHadith"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:minHeight="150dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card_r51"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/rowCounters">

            <TextView
                android:id="@+id/txtHadith"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="18dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="18dp"
                android:layout_marginBottom="18dp"
                android:gravity="center"
                android:text="عن أبي هريرة رضي الله عنه أن النبي ﷺ قال:&#10;&quot;كلمتان خفيفتان على اللسان ثقيلتان في الميزان حبيبتان إلى الرحمن: سبحان الله وبحمده سبحان الله العظيم&quot;"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:lineSpacingMultiplier="1.1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.5" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Athkar en plein écran (10 min après chaque Iqama).
             Largeur/hauteur 0dp + contraintes = couvre tout l'écran interne. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/overlayAthkar"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:elevation="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Limites verticales de l'overlay: modifiez les pourcentages (0.08 et 0.88) pour régler la hauteur visible du carton. -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideAthkarTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.05" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideAthkarBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.95" />

            <!-- Carton Athkar: contrôlez sa taille via les marges (Start/End/Top/Bottom) et les guidelines ci-dessus. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/overlayCard"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:background="@drawable/bg_card_r51"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="40dp"
                android:paddingBottom="10dp"
                app:layout_constraintTop_toTopOf="@id/guideAthkarTop"
                app:layout_constraintBottom_toBottomOf="@id/guideAthkarBottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Titre Athkar: taille via textSize (20sp). -->
                <TextView
                    android:id="@+id/overlayAthkarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/athkar_after_prayer_title"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- Corps Athkar: zone non-scrollable, ajustée entre le titre et le bas. -->
                <TextView
                    android:id="@+id/overlayAthkarBody"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:gravity="start"
                    android:textAlignment="viewStart"
                    android:textDirection="rtl"
                    android:text="@string/athkar_after_prayer_body"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:lineSpacingExtra="3dp"
                    android:lineSpacingMultiplier="1"
                    android:includeFontPadding="false"
                    app:layout_constraintTop_toBottomOf="@id/overlayAthkarTitle"
                    android:layout_marginTop="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bouton paramètres (coin haut droit). Modifiez layout_width/height (32dp), marges et textSize (18sp). -->
    <TextView
        android:id="@+id/btnSettings"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:alpha="0.3"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="⚙"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Lien footer (sous le panneau). Positionné sous l'image de fond via Top_toBottomOf=@id/imgBackground. -->
    <TextView
        android:id="@+id/txtFooterLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        android:background="@android:color/white"
        android:paddingStart="6dp"
        android:paddingTop="4dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:elevation="16dp"
        android:text="iScan.sa/Adhan"
        android:textColor="@android:color/black"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
